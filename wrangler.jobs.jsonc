{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-tool-hub-jobs",
  "main": "src/workers/jobs.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "0 2 * * *",
      "0 3 * * 1",
      "0 4 * * *",
      "0 5 * * *",
      "0 6 * * 1"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-tool-hub",
      "database_id": "740a2a8f-c9d3-49cf-837b-c4e8f921ea56",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "binding": "AGENT_TOOL_HUB_JOBS",
      "name": "agent-tool-hub-jobs",
      "class_name": "AgentToolHubWorkflow"
    }
  ],
  "vars": {
    "AGENT_TOOL_HUB_APP_URL": "https://agent-tool-hub.agent-tool-hub-tim888888.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://agent-tool-hub.agent-tool-hub-tim888888.workers.dev"
  }
}
