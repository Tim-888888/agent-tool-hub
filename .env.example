# Database
# Local Prisma CLI fallback. Runtime production database is the Cloudflare D1 DB binding.
DATABASE_URL="file:./dev.db"

# GitHub API (optional, for higher rate limits)
GITHUB_TOKEN=""

# Auth.js v5 — GitHub OAuth
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Admin — comma-separated GitHub user IDs
ADMIN_GITHUB_IDS=""
# Same IDs with NEXT_PUBLIC_ prefix for client-side admin check
NEXT_PUBLIC_ADMIN_GITHUB_IDS=""

# 智谱 GLM API (for auto-translation during tool approval)
GLM_API_KEY=""

# Cloudflare Worker URL used by the jobs Worker to call app routes
AGENT_TOOL_HUB_APP_URL="https://agenttoolhub.com"

# Cron secret used by Cloudflare Workflows/jobs to call internal job routes
CRON_SECRET=""

# Base URL for sitemap/canonical URLs
NEXT_PUBLIC_APP_URL="https://agenttoolhub.com"

# Resend (email sending for Pro weekly digest)
RESEND_API_KEY=""
