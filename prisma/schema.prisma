generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ToolType {
  MCP_SERVER
  SKILL
  RULE
}

enum ToolStatus {
  PENDING
  ACTIVE
  FEATURED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tool {
  id            String     @id @default(cuid())
  slug          String     @unique
  name          String
  description   String
  descriptionZh String?
  type          ToolType
  status        ToolStatus @default(ACTIVE)

  repoUrl       String
  homepageUrl   String?
  npmPackage    String?
  pypiPackage   String?

  stars         Int       @default(0)
  forks         Int       @default(0)
  openIssues    Int       @default(0)
  language      String?
  license       String?
  lastCommitAt  DateTime?
  author        String?
  version       String?

  isFeatured    Boolean   @default(false)
  installGuide  Json?

  avgRating     Float     @default(0)
  ratingCount   Int       @default(0)

  score         Float?
  syncedAt      DateTime?
  npmDownloads  Int?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tags            ToolTag[]
  transports      ToolTransport[]
  features        ToolFeature[]
  screenshots     ToolScreenshot[]
  categories      ToolCategory[]
  platforms       ToolPlatform[]
  reviews         Review[]
  submissions     Submission[]
  tagVotes        ToolTagVote[]
  favorites       Favorite[]
  collectionTools CollectionTool[]
  subscriptions   ToolSubscription[]
  notifications   Notification[]

  @@index([type, status])
  @@index([stars])
  @@index([lastCommitAt])
  @@index([isFeatured])
  @@index([name])
  @@index([score])
}

model ToolTag {
  id        String @id @default(cuid())
  toolId    String
  value     String
  sortOrder Int    @default(0)

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, value])
  @@index([toolId])
  @@index([value])
}

model ToolTransport {
  id        String @id @default(cuid())
  toolId    String
  value     String
  sortOrder Int    @default(0)

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, value])
  @@index([toolId])
  @@index([value])
}

model ToolFeature {
  id        String @id @default(cuid())
  toolId    String
  locale    String
  value     String
  sortOrder Int    @default(0)

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, locale, sortOrder])
  @@index([toolId, locale])
  @@index([locale])
}

model ToolScreenshot {
  id        String @id @default(cuid())
  toolId    String
  url       String
  sortOrder Int    @default(0)

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, url])
  @@index([toolId])
}

model Category {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameEn        String
  nameZh        String
  icon          String
  descriptionEn String?
  descriptionZh String?
  order         Int            @default(0)
  tools         ToolCategory[]

  @@index([slug])
}

model Platform {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  icon      String
  configKey String
  tools     ToolPlatform[]

  @@index([slug])
}

model ToolCategory {
  toolId     String
  categoryId String
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([toolId, categoryId])
}

model ToolPlatform {
  toolId     String
  platformId String
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([toolId, platformId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isPro         Boolean   @default(false)
  proNewsletter Boolean   @default(false)
  proToken      String?   @unique
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  submissions   Submission[]
  tagVotes      ToolTagVote[]
  favorites     Favorite[]
  subscriptions ToolSubscription[]
  notifications Notification[]
  digestSends   DigestSend[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Review {
  id        String   @id @default(cuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  content   String?
  platform  String?
  useCase   String?
  createdAt DateTime @default(now())

  @@unique([userId, toolId])
  @@index([toolId])
  @@index([userId])
}

model Submission {
  id             String                  @id @default(cuid())
  toolId         String?
  tool           Tool?                   @relation(fields: [toolId], references: [id])
  userId         String?
  user           User?                   @relation(fields: [userId], references: [id])
  repoUrl        String
  submitterName  String?
  submitterEmail String?
  notes          String?
  suggestedTags  SubmissionSuggestedTag[]
  status         SubmissionStatus        @default(PENDING)
  createdAt      DateTime                @default(now())
  reviewedAt     DateTime?

  @@index([status])
}

model SubmissionSuggestedTag {
  id           String @id @default(cuid())
  submissionId String
  value        String
  sortOrder    Int    @default(0)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, value])
  @@index([submissionId])
}

model ToolTagVote {
  id        String   @id @default(cuid())
  toolId    String
  tagSlug   String
  userId    String
  createdAt DateTime @default(now())

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, tagSlug, userId])
  @@index([toolId])
  @@index([toolId, tagSlug])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
  @@index([toolId])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("en")
  active         Boolean   @default(true)
  token          String    @unique
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([email])
  @@index([active])
}

model TranslationCache {
  id            String                    @id @default(cuid())
  sourceHash    String                    @unique
  sourceText    String
  descriptionZh String?
  features      TranslationCacheFeature[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([sourceHash])
}

model TranslationCacheFeature {
  id                 String @id @default(cuid())
  translationCacheId String
  value              String
  sortOrder          Int    @default(0)

  cache TranslationCache @relation(fields: [translationCacheId], references: [id], onDelete: Cascade)

  @@unique([translationCacheId, sortOrder])
  @@index([translationCacheId])
}

model Collection {
  id            String           @id @default(cuid())
  slug          String           @unique
  titleEn       String
  titleZh       String
  descriptionEn String?
  descriptionZh String?
  icon          String?
  coverImage    String?
  isPublished   Boolean          @default(false)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tools         CollectionTool[]

  @@index([isPublished])
  @@index([sortOrder])
}

model CollectionTool {
  collectionId String
  toolId       String
  sortOrder    Int      @default(0)
  noteEn       String?
  noteZh       String?
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tool       Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([collectionId, toolId])
  @@index([collectionId])
}

model ToolSubscription {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
  @@index([toolId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId])
  @@index([toolId])
}

model DigestSend {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt    DateTime @default(now())
  toolCount Int
  status    String   @default("sent")
  error     String?

  @@index([userId])
  @@index([sentAt])
}

model SkillSyncState {
  id          String   @id @default("default")
  lastSyncAt  DateTime @default(now())
  totalRepos  Int      @default(0)
  syncedRepos Int      @default(0)
}

model JobRun {
  id          String    @id @default(cuid())
  workflow    String
  status      String    @default("queued")
  cursor      String?
  payload     Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workflow, status])
  @@index([createdAt])
}
