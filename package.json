{
  "name": "agent-tool-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && node scripts/copy-open-next-wasm.mjs && wrangler dev",
    "deploy": "opennextjs-cloudflare build && node scripts/copy-open-next-wasm.mjs && wrangler deploy",
    "upload": "opennextjs-cloudflare build && node scripts/copy-open-next-wasm.mjs && wrangler deploy --dry-run",
    "jobs:dev": "wrangler dev --config wrangler.jobs.jsonc",
    "jobs:deploy": "wrangler deploy --config wrangler.jobs.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv src/env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply agent-tool-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply agent-tool-hub --remote",
    "db:export:postgres": "node scripts/export-postgres-to-d1.mjs",
    "db:export:vercel-public": "node scripts/export-vercel-public-api-to-d1.mjs",
    "db:import:local": "wrangler d1 execute agent-tool-hub --local --file exports/postgres-to-d1.sql",
    "db:import:remote": "wrangler d1 execute agent-tool-hub --remote --file exports/postgres-to-d1.sql",
    "db:import:public:local": "wrangler d1 execute agent-tool-hub --local --file exports/vercel-public-to-d1.sql",
    "db:import:public:remote": "wrangler d1 execute agent-tool-hub --remote --file exports/vercel-public-to-d1.sql",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@formatjs/intl-localematcher": "^0.8.2",
    "@opennextjs/cloudflare": "^1.12.0",
    "@prisma/adapter-d1": "6.19.0",
    "@prisma/client": "6.19.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "negotiator": "^1.0.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "prisma": "6.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260520.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.98.0"
  }
}
